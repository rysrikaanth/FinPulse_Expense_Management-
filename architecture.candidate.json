  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Deduplication Pipeline",
      "items": [
        "Mindee V2 OCR extracts line items, totals, dates, and vendor names with confidence scoring",
        "Normalizer maps raw API payloads into canonical ExpenseRecord Pydantic models",
        "Dual deduplication: SHA-256 fingerprint exact match + Faiss L2 SBERT semantic vector search",
        "Tri-state resolver triage: reject duplicate, flag ambiguous match, or accept unique expense"
      ]
    },
    {
      "dot": "emerald",
      "title": "ML Categorization & Anomaly Detection",
      "items": [
        "LightGBM multi-class categorizer trained on 387-dim features (384 SBERT embeddings + 3 scalar signals)",
        "Ensemble anomaly detection combining Per-User Isolation Forest and PyTorch Deep Autoencoder",
        "SHAP TreeExplainer feature attributions for human-in-the-loop review transparency"
      ]
    },
    {
      "dot": "amber",
      "title": "Forecasting & Early Warning",
      "items": [
        "Facebook Prophet time-series models predict category-specific spend 30 days ahead with uncertainty intervals",
        "Early warning engine tracks burn rate against user monthly limits to alert before budget overrun"
      ]
    },
    {
      "dot": "rose",
      "title": "RAG Insights & Multi-Role Governance",
      "items": [
        "RAG context builder injects user KPIs, spending trends, and anomalies into Gemini 2.5 Flash prompts",
        "Hallucination checker verifies generated insights against retrieved numerical data",
        "Role-based views in Streamlit dashboard (User: claim submission & status; Admin: analytics & review queue)"
      ]
    }
  ]
